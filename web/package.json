{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "infisical run --env=dev --path=/shared --path=/personal/abhishek -- npm run dev:raw",
    "dev:raw": "npm run catalog && concurrently -k -n web,worker -c blue,magenta \"next dev\" \"tsx worker/index.ts\"",
    "start": "infisical run --env=prod --path=/shared --path=/personal/abhishek -- npm run start:raw",
    "start:raw": "concurrently -k -n web,worker \"next start\" \"tsx worker/index.ts\"",
    "build": "npm run catalog && next build",
    "catalog": "node scripts/build-catalog.mjs",
    "worker": "tsx worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "seed": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@anthropic-ai/sdk": "^0.128.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}

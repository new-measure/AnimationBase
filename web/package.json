{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev -- npm run dev:raw",
    "dev:raw": "npm run catalog && concurrently -k -n web,worker -c blue,magenta \"next dev\" \"tsx worker/index.ts\"",
    "start": "infisical run --env=prod -- npm run start:raw",
    "start:raw": "concurrently -k -n web,worker \"next start\" \"tsx worker/index.ts\"",
    "build": "next build",
    "catalog": "node scripts/build-catalog.mjs",
    "worker": "tsx worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "seed": "infisical run --env=dev -- tsx scripts/seed-demo.ts",
    "db:push": "infisical run --env=dev -- drizzle-kit push",
    "db:push:prod": "infisical run --env=prod -- drizzle-kit push",
    "db:seed": "infisical run --env=dev -- tsx scripts/seed-models.ts",
    "deploy": "npm run catalog && vercel deploy --prod"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@neondatabase/serverless": "^1.1.0",
    "@workos-inc/authkit-nextjs": "^4.3.2",
    "drizzle-orm": "^0.45.3",
    "modal": "^0.10.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
